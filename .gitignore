# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ml_kit runtime outputs (generated next to input data)
*_ml_data/
*_pred_*.csv
report_*.docx

# Archives (code lives in ml_kit/ as plain files)
*.7z
*.zip
!archive/engenius/package/*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Offline wheel bundles (prepared per environment, not versioned)
wheels/

# Tool runtime data (error logs, caches) - each tool folder
CLI/*/data/
CLI/work/
CLI/*/cache/
CLI/office-cli/config.json

# 배포 설치(CLI/setup.py): 보관 폴더(data/setup_backup_<시각>), 사용자가 넣는 OpenCode 설정(사내 LLM 주소)
CLI/data/
CLI/opencode/opencode.jsonc
# 배포 때 C:\CLI에 함께 두는 것 (저장소에는 넣지 않음)
CLI/python/
CLI/opencode.exe

# 실기 자동 점검 결과 (CLI-dev/run_all_tests.py)
CLI-dev/result_*.md

# 실기 테스트 로그: 사용자가 GitHub 웹으로 docs/test_logs/에 직접 올림 (git 명령으로는 올리지 않음). 프로젝트 마무리 때 이력에서 정리
docs/test_logs/
CLI-dev/*/tools/test_logs/
**/test_log*.txt
**/test_result*.txt

# 베타 도구 점검 결과 (CLI-dev/run_beta_check.py, grade_opencode.py)
CLI-dev/beta_check_*.md
CLI-dev/beta_check_*.xlsx
CLI-dev/grade_*.md
CLI-dev/grade_*.xlsx

# 실기 점검 시험 폴더 (run_all_tests.py, run_beta_check.py, 실기 러너, 눈 확인)
CLI-dev/work/
