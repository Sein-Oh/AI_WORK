# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ml_kit runtime outputs (generated next to input data)
*_ml_data/
*_pred_*.csv
report_*.docx

# Archives (code lives in ml_kit/ as plain files)
*.7z
*.zip
!archive/engenius/package/*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Offline wheel bundles (prepared per environment, not versioned)
wheels/

# Tool runtime data (error logs, caches) - each tool folder
AIKIT/*/data/
AIKIT/*/cache/
AIKIT/office-cli/config.json

# 배포 설치(AIKIT/setup.py): 보관 폴더(data/setup_backup_<시각>). opencode.jsonc(사내 LLM 주소)는 사용자 전역 설정에 두지만 실수로 넣어도 올리지 않게
AIKIT/data/
AIKIT/opencode.jsonc
# C:\AIKIT 프로젝트의 OpenCode 폴더(.opencode): 기본 스킬 12개만 저장소에 넣음 (사용자가 만든 스킬, OpenCode가 만드는 파일은 제외)
AIKIT/.opencode/*
!AIKIT/.opencode/skills/
AIKIT/.opencode/skills/*
!AIKIT/.opencode/skills/ml-train/
!AIKIT/.opencode/skills/ml-dataset/
!AIKIT/.opencode/skills/ml-predict/
!AIKIT/.opencode/skills/ml-report/
!AIKIT/.opencode/skills/ml-map/
!AIKIT/.opencode/skills/excel-kit/
!AIKIT/.opencode/skills/excel-format-kit/
!AIKIT/.opencode/skills/word-kit/
!AIKIT/.opencode/skills/ppt-kit/
!AIKIT/.opencode/skills/outlook-kit/
!AIKIT/.opencode/skills/search-kit/
!AIKIT/.opencode/skills/stats-kit/
!AIKIT/.opencode/skills/pandas-kit/
# OpenCode가 만들 수 있는 실행 파일 (백그라운드 서비스 정보)
AIKIT/service.json
# 배포 때 C:\AIKIT에 함께 두는 것 (저장소에는 넣지 않음)
AIKIT/python/
AIKIT/opencode.exe

# 실기 자동 점검 결과 (AIKIT/dev/run_all_tests.py)
AIKIT/dev/result_*.md

# 실기 테스트 로그: 사용자가 GitHub 웹으로 docs/test_logs/에 직접 올림 (git 명령으로는 올리지 않음). 프로젝트 마무리 때 이력에서 정리
docs/test_logs/
AIKIT/dev/*/tools/test_logs/
**/test_log*.txt
**/test_result*.txt

# 베타 도구 점검 결과 (AIKIT/dev/run_beta_check.py, grade_opencode.py)
AIKIT/dev/beta_check_*.md
AIKIT/dev/beta_check_*.xlsx
AIKIT/dev/grade_*.md
AIKIT/dev/grade_*.xlsx

# 실기 점검 시험 폴더 (run_all_tests.py, run_beta_check.py, 실기 러너, 눈 확인)
AIKIT/dev/work/
